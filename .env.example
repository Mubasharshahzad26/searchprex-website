# =============================================================================
# SearchPrex — required environment variables
# =============================================================================
# Copy to .env.local and fill in real values. This file holds NAMES ONLY:
# never commit secrets. .env.local is gitignored; this template is not.

# -----------------------------------------------------------------------------
# Admin / CMS authentication  ** REQUIRED **
# -----------------------------------------------------------------------------
# Without these two, middleware.ts fails CLOSED: /admin and /dashboard return
# 503 because no one can be authenticated. Find them in your Supabase project
# under Settings -> API. The anon key is safe to expose to the browser; the
# service-role key is not and is deliberately absent from this file.
#
# The signed-in user must also have profiles.role = 'admin' to reach /admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Canonical site URL
# -----------------------------------------------------------------------------
# Used by lib/admin-seo.ts, app/sitemap.ts and app/layout.tsx to build absolute
# canonical and Open Graph URLs. No trailing slash.
# Falls back to https://www.searchprex.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.searchprex.com

# -----------------------------------------------------------------------------
# Google Search Console verification (optional)
# -----------------------------------------------------------------------------
# The token from the "HTML tag" verification method — the content value only,
# not the whole <meta> tag. app/layout.tsx emits the tag ONLY when this is set,
# so leaving it blank is safe: a placeholder would publish a tag that actively
# fails verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Database (Prisma + Neon Postgres)  ** REQUIRED **
# -----------------------------------------------------------------------------
# Pooled connection string used at runtime. prisma.config.ts reads this.
DATABASE_URL=
# Direct (unpooled) connection, required for migrations.
DATABASE_URL_UNPOOLED=

# -----------------------------------------------------------------------------
# Integrations
# -----------------------------------------------------------------------------
# Shared secret for /api cron endpoints (Vercel Cron sends it as a header).
CRON_SECRET=
# Google Gemini, used by the autopilot content generation.
GEMINI_API_KEY=
# Path to the Google service-account JSON used for the Indexing API + GSC.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Resend, used for transactional email.
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Email sender identities  ** REQUIRED for reports and SDR to actually arrive **
# -----------------------------------------------------------------------------
# Client reports previously sent from onboarding@resend.dev — Resend's SHARED
# SANDBOX sender, which accepts the send, reports success, and delivers only to
# your own Resend account. Every cron run looked healthy while no client got a
# report. lib/email-identity.ts now THROWS on that address rather than repeat it.
#
# Must be on a domain verified at resend.com/domains (SPF + DKIM + DMARC).
# Defaults to reports@<NEXT_PUBLIC_SITE_URL host> when unset.
REPORTS_FROM_EMAIL=
REPORTS_FROM_NAME=

# Cold outreach sender for the AI SDR. Keep this OFF the primary domain: cold
# volume shares a sending reputation with everything else on the domain, so
# enough complaints here and client reports start landing in spam. Verify a
# subdomain such as outreach.searchprex.com and point this at it.
# Defaults to contact@<primary domain>, which logs a warning on every send.
SDR_FROM_EMAIL=
SDR_FROM_NAME=

# A valid physical postal address is a legal requirement in commercial email
# (CAN-SPAM). Without it the SDR route refuses to send rather than omitting it.
COMPANY_POSTAL_ADDRESS=
# Defaults to "Reply with STOP and I will not contact you again."
OUTREACH_OPT_OUT_TEXT=

# Domains that must NEVER originate cold outreach from the link-building module,
# comma separated. The site's own domain is always protected whether listed or
# not; add anything else that sends invoices or account mail.
OUTREACH_PROTECTED_DOMAINS=

# -----------------------------------------------------------------------------
# DataForSEO  ** REQUIRED for the SERP Checker to return real rankings **
# -----------------------------------------------------------------------------
# Without these, /api/serp-checker silently returns deterministic ESTIMATED
# data: the positions and the "top 10" competitor list are invented. The UI does
# label it "Estimated demo data", so nothing is misrepresented — but the tool is
# not a rank checker until these are set.
#
# Used by app/api/serp-checker/route.ts and lib/keyword-service.ts.
# Sign up at https://dataforseo.com — the login is your account email and the
# password is the API password from Dashboard -> API Access (NOT your website
# password). Add both to Vercel -> Settings -> Environment Variables too.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# -----------------------------------------------------------------------------
# WordPress publishing target (optional, autopilot integration tests)
# -----------------------------------------------------------------------------
WP_TEST_URL=
WP_TEST_URL_PUBLIC=
WP_TEST_USERNAME=
WP_TEST_APP_PASSWORD=
