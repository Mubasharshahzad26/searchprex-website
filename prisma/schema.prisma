// --- NEW AI SDR MODELS --- //

model AiSdrLead {
  id              String   @id @default(cuid())
  websiteUrl      String   @unique
  companyName     String?
  niche           String?
  location        String?
  contactEmail    String?
  score           Int?
  analysis        String?  @db.Text
  status          String   @default("new") // new, qualified, emailed, responded, rejected, opened, clicked
  emailCount      Int      @default(0)
  lastEmailedAt   DateTime?
  lighthouseScore Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  emailLogs       AiSdrEmailLog[]
}

model AiSdrEmailLog {
  id              String   @id @default(cuid())
  leadId          String
  lead            AiSdrLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject         String
  body            String   @db.Text
  sentAt          DateTime @default(now())
