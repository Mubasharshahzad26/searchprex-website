datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Client {
  id          String   @id @default(cuid())
  companyName String
  email       String   @unique
  domain      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gscConnections  GSCConnection[]
  cmsConnections  CMSConnection[]
  autopilotConfig AutopilotConfig?
  autopilotRuns   AutopilotRun[]
  costLogs        CostLog[]
  reportConfig    ReportConfig?
  blogPosts       BlogPost[]
}

model GSCConnection {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteUrl            String
  serviceAccountJson String
  connectedAt        DateTime  @default(now())
  lastSyncedAt       DateTime?
  syncStatus         String    @default("pending")

  @@unique([clientId, siteUrl])
  @@index([clientId])
}

model CMSConnection {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cmsType     String
  baseUrl     String
  credentials Json
  testStatus  String   @default("pending")
  connectedAt DateTime @default(now())

  @@unique([clientId, cmsType])
  @@index([clientId])
}

model AutopilotConfig {
  id                String   @id @default(cuid())
  clientId          String   @unique
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(false)
  automationScore   String
  maxPagesPerRun    Int      @default(5)
  contentTier       String
  scheduleFrequency String
  dryRunMode        Boolean  @default(true)
  requiresApproval  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  runs AutopilotRun[]
}

model AutopilotRun {
  id             String          @id @default(cuid())
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  configId       String
  config         AutopilotConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  status         String
  pagesTargeted  Int
  pagesGenerated Int             @default(0)
  pagesPublished Int             @default(0)
  dryRun         Boolean         @default(false)
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  errorMessage   String?
  results        Json?

  pages   AutopilotPage[]
  costLog CostLog?

  @@index([clientId])
}

model AutopilotPage {
  id               String       @id @default(cuid())
  runId            String
  run              AutopilotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  pageUrl          String
  gscImpressions   Int
  gscClicks        Int
  gscPosition      Float?
  status           String
  generatedContent Json?
  publishAt        DateTime?
  publishedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime     @default(now())

  @@unique([runId, pageUrl])
  @@index([runId])
  @@index([status, publishAt])
}

model CostLog {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  runId          String?       @unique
  run            AutopilotRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  service        String
  pagesProcessed Int
  costPerPage    Float
  totalCost      Float
  createdAt      DateTime      @default(now())

  @@index([clientId])
}

model ReportConfig {
  id             String    @id @default(cuid())
  clientId       String    @unique
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recipientEmail String
  ccEmails       String?
  frequency      String    @default("weekly")
  sendDay        Int       @default(1)
  sendHourUTC    Int       @default(9)
  enabled        Boolean   @default(true)
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model IndexingAccount {
  id              String   @id @default(cuid())
  label           String
  clientEmail     String   @unique
  credentialsJson String
  dailyQuota      Int      @default(200)
  usedToday       Int      @default(0)
  lastResetAt     DateTime @default(now())
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  logs IndexingLog[]
}

model IndexingLog {
  id          String          @id @default(cuid())
  accountId   String
  account     IndexingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  url         String
  type        String          @default("new")
  status      String
  response    String?
  submittedAt DateTime        @default(now())

  @@index([accountId])
  @@index([submittedAt])
}

model IndexingQueue {
  id          String    @id @default(cuid())
  url         String    @unique
  clientId    String
  priority    Int       @default(2)
  status      String    @default("queued")
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, priority])
  @@index([clientId])
}

model AuditRun {
  id           String    @id @default(cuid())
  clientId     String?
  siteUrl      String
  sitemapUrl   String
  status       String    @default("running")
  totalPages   Int       @default(0)
  sampledPages Int       @default(0)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  pages    AuditPage[]
  insights AuditInsight[]

  @@index([clientId])
  @@index([startedAt])
}

model AuditPage {
  id                 String   @id @default(cuid())
  runId              String
  run                AuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  url                String
  statusCode         Int?
  title              String?
  titleLength        Int?
  metaDescription    String?
  metaLength         Int?
  h1Count            Int?
  h1Text             String?
  wordCount          Int?
  internalLinksCount Int?
  externalLinksCount Int?
  imageCount         Int?
  imagesMissingAlt   Int?
  canonical          String?
  hasSchema          Boolean  @default(false)
  issues             Json?
  crawledAt          DateTime @default(now())

  @@unique([runId, url])
  @@index([runId])
}

model AuditInsight {
  id          String   @id @default(cuid())
  runId       String
  run         AuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  pageUrl     String
  category    String
  priority    Int      @default(2)
  reason      String
  actionTaken String?
  createdAt   DateTime @default(now())

  @@index([runId, category])
}

model RoadmapPlan {
  id               String   @id @default(cuid())
  clientId         String?
  siteUrl          String
  auditRunId       String?
  industry         String   @default("general")
  healthScore      Int?
  executiveSummary String?  @db.Text
  plan             Json
  expectedMetrics  Json?
  status           String   @default("generated")
  generatedAt      DateTime @default(now())
  errorMessage     String?

  @@index([clientId])
  @@index([auditRunId])
  @@index([generatedAt])
}

model BlogPost {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  topic    String
  category String // "comparison" | "buying-guide" | "educational" | "roundup"
  keywords String[] // primary + LSI keywords

  status      String    @default("queued") // queued, generating, published, error
  scheduledAt DateTime?
  publishedAt DateTime?

  wpPostId Int?
  liveUrl  String?

  generatedContent Json? // { metaTitle, metaDescription, contentHtml, faqs, quality }
  errorMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([scheduledAt])
}

model Page {
  id               String   @id @default(cuid())
  slug             String   @unique // e.g., "/" for home, "/about" for about
  title            String
  metaDescription  String
  canonicalUrl     String?

  // Open Graph
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  ogType           String?  @default("website") // website, article, product, etc.

  // Twitter Card
  twitterCard      String?  @default("summary_large_image")
  twitterTitle     String?
  twitterDescription String?
  twitterImage     String?

  // Robots & Indexing
  robots           String?  @default("index, follow") // index/noindex, follow/nofollow
  metaKeywords     String[] // SEO keywords array

  // Schema.org JSON-LD
  schemaType       String?  // Organization, WebPage, FAQPage, VideoObject, Product, etc.
  schemaData       Json?    // Full JSON-LD structured data

  // Content
  contentBlocks    Json?    // Stores text, links, and media for the page

  // Status
  status           String   @default("published") // published, draft, archived

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Cached SERP results for the free SERP Checker.
///
/// DataForSEO bills per keyword checked, and the tool is public and
/// unauthenticated. Without this, one scripted client could run the account
/// down — and most traffic is repeat queries anyway ("personal injury lawyer
/// detroit" is the same SERP for every visitor who asks that hour).
///
/// `cacheKey` is keyword|location|device, lowercased and whitespace-collapsed.
model SerpCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  keyword   String
  location  String
  /// A serialised SerpKeywordResult from lib/serp-types.
  payload   Json
  /// Incremented on every cache hit — shows which queries are worth pre-warming.
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

/// Durable per-visitor quota for the SERP Checker.
///
/// The route's original limiter was a module-level Map. On Vercel every lambda
/// instance holds its own copy and instances churn constantly, so the limit was
/// effectively unenforced in production. This survives across instances.
///
/// `visitorHash` is a salted SHA-256 of the IP, never the IP itself — the raw
/// address is personal data and there is no reason to store it.
model SerpUsage {
  id          String   @id @default(cuid())
  visitorHash String
  /// UTC calendar day, YYYY-MM-DD.
  day         String
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([visitorHash, day])
  @@index([day])
}
